{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../UncreatedWarfare",
          "files": [
            "UncreatedWarfare/UncreatedWarfare.csproj"
          ]
        }
      ],
      "output": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "UncreatedWarfare/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Uncreated Framework",
      "_appTitle": "Uncreated Framework",
      "_enableSearch": true,
      "pdf": false
    },
    "xref": [
      "https://normanderwan.github.io/UnityXrefMaps/2022.3/xrefmap.yml",
      "https://learn.microsoft.com/en-us/dotnet/.xrefmap.json"
    ],
    "sitemap": {
      "baseUrl": "https://uncreated.network/doc",
      "priority": 0.35,
      "changefreq": "monthly"
    }
  }
}